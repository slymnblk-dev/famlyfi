{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Famlyfi",
  "version": "0.57.0",
  "identifier": "com.famlyfi.app",
  "build": {
    "frontendDist": "https://famlyfi.com"
  },
  "app": {
    "windows": [
      {
        "title": "Famlyfi",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Famlyfi",
    "shortDescription": "Family finance, simply.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
