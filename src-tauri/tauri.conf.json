{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Famlyfi",
  "version": "0.64.0",
  "identifier": "com.famlyfi.app",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Famlyfi",
        "url": "https://famlyfi.com",
        "visible": false,
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      },
      {
        "label": "splash",
        "title": "Famlyfi",
        "url": "index.html",
        "width": 360,
        "height": 400,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Famlyfi",
    "shortDescription": "Family finance, simply.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4QjdDNUZBNUI4NjgxOTMKUldTVGdZWmIrc1czMklrcWp5eVcwVDIvajloR1RwdnptcmtRUzJQWHlVWCtndGQxaHNJZk9EUzkK",
      "endpoints": [
        "https://github.com/slymnblk-dev/famlyfi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}